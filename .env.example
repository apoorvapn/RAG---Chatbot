# Copy to .env:  cp .env.example .env

# "ollama" = free, runs open-source models on your own computer (default)
# "openai" = paid OpenAI API (also set OPENAI_API_KEY below)
PROVIDER=ollama

# Only needed if PROVIDER=openai
OPENAI_API_KEY=sk-your-key-here

# Optional: change the local models (must be pulled with `ollama pull <name>`)
# OLLAMA_CHAT_MODEL=llama3.2
# OLLAMA_EMBED_MODEL=nomic-embed-text
